# ============================================================
#  Variables de entorno — EJEMPLO
#  Copia a .env y rellena con tus valores reales.
# ============================================================

# ── Red ───────────────────────────────────────────────────
# IP en la que se publican los puertos: la del host SOAR en la
# VLAN SOC. Nunca 0.0.0.0 (Ollama no tiene autenticación).
SOC_BIND=127.0.0.1

# ── Shuffle ───────────────────────────────────────────────
SHUFFLE_VERSION=2.3.0
# UUID consistente en backend y orborus (no el literal "Shuffle")
SHUFFLE_ORG_ID=00000000-0000-0000-0000-000000000000
SHUFFLE_USER=admin
SHUFFLE_PASS=CAMBIAME

# ── TheHive ───────────────────────────────────────────────
# Genera un secreto largo: openssl rand -base64 32
THEHIVE_SECRET=CAMBIAME_secreto_largo_aleatorio
# Clave de API de un usuario de Cortex (se crea en la interfaz de Cortex)
CORTEX_API_KEY=

# ── MISP ──────────────────────────────────────────────────
MISP_BASE_URL=https://CAMBIAME:8443
MISP_ADMIN_EMAIL=admin@example.test
MISP_ADMIN_PASSWORD=CAMBIAME
MISP_VERSION=v2.5.50
# openssl rand -base64 24
MISP_DB_PASSWORD=CAMBIAME
MISP_REDIS_PASSWORD=CAMBIAME

# ── Webhook de Shuffle (referencia, se usa en ossec.conf) ──
# https://<HOST_SOC>:3443/api/v1/hooks/webhook_XXXXXXXX
