<!--
  ============================================================
   soc_rules.xml — Reglas personalizadas del SOC (serie 110xxx)
   Mapean las detecciones de los sensores a niveles y MITRE.
  ============================================================
   Ubicación:  /var/ossec/etc/rules/soc_rules.xml

   Nombres de campo: en una regla de Wazuh los campos del
   decodificador json se nombran SIN el prefijo "data."
   (output_fields.proc.name). "data." es solo cómo aparecen
   luego dentro de la alerta. Con data.* delante, ninguna de
   estas reglas casaba.

   Falco escribe "source":"syscall" (singular). La regla base
   esperaba "syscalls", así que todas las 1100xx colgaban de
   una regla que no saltaba nunca.

   Tetragon no tiene campo "source": sus eventos se reconocen
   por process_kprobe (políticas como bloqueo-acceso-shadow) o
   por process_exec.

   Comprobar con /var/ossec/bin/wazuh-logtest pegando una
   línea real de falco.log y de tetragon.log.
  ============================================================
-->
<group name="soc,custom,">

  <!-- Regla base de Falco / PatchGuard -->
  <rule id="110000" level="3">
    <decoded_as>json</decoded_as>
    <field name="source">^syscall$</field>
    <field name="rule">\.+</field>
    <description>SOC/Falco: evento de sensor recibido</description>
    <group>soc_sensor,falco,</group>
  </rule>

  <!-- Regla base de Tetragon: una TracingPolicy ha saltado -->
  <rule id="110001" level="3">
    <decoded_as>json</decoded_as>
    <field name="process_kprobe.policy_name">\.+</field>
    <description>SOC/Tetragon: politica $(process_kprobe.policy_name)</description>
    <group>soc_sensor,tetragon,</group>
  </rule>

  <!-- Regla base de Tetragon: ejecucion de proceso -->
  <rule id="110002" level="0">
    <decoded_as>json</decoded_as>
    <field name="process_exec.process.binary">\.+</field>
    <description>SOC/Tetragon: ejecucion de proceso</description>
    <group>soc_sensor,tetragon,</group>
  </rule>

  <!-- Fase 2 · Shell interactiva (T1059) -->
  <rule id="110010" level="8">
    <if_sid>110000</if_sid>
    <field name="output_fields.proc.name">^bash$|^sh$|^zsh$</field>
    <!-- Falco pone proc.tty=0 cuando no hay terminal -->
    <field name="output_fields.proc.tty" negate="yes">^0$</field>
    <description>SOC/Falco: shell interactiva detectada</description>
    <mitre>
      <id>T1059.004</id>
    </mitre>
    <group>falco,execution,</group>
  </rule>

  <!-- Fase 4 · Acceso a /etc/shadow (T1003) — CRÍTICO, dispara SOAR -->
  <rule id="110020" level="12">
    <if_sid>110000</if_sid>
    <field name="output_fields.fd.name">^/etc/shadow$</field>
    <description>SOC/Falco: acceso a /etc/shadow (volcado de credenciales)</description>
    <mitre>
      <id>T1003.008</id>
    </mitre>
    <group>falco,credential_access,</group>
  </rule>

  <rule id="110021" level="12">
    <if_sid>110001</if_sid>
    <field name="process_kprobe.policy_name">^bloqueo-acceso-shadow$</field>
    <description>SOC/Tetragon: proceso $(process_kprobe.process.binary) terminado al abrir /etc/shadow</description>
    <mitre>
      <id>T1003.008</id>
    </mitre>
    <group>tetragon,credential_access,</group>
  </rule>

  <!-- Fase 5 · Descarga de payload con wget/curl (T1105) -->
  <rule id="110030" level="10">
    <if_sid>110000</if_sid>
    <field name="output_fields.proc.name">^wget$|^curl$</field>
    <description>SOC/Falco: descarga de fichero remoto (posible payload)</description>
    <mitre>
      <id>T1105</id>
    </mitre>
    <group>falco,command_and_control,</group>
  </rule>

  <!-- Falso positivo: Suricata crea packet sockets en volumen.
       Suprimimos esa alerta concreta bajándola a nivel 0. -->
  <rule id="110040" level="0">
    <if_sid>110000</if_sid>
    <field name="output_fields.proc.name">^Suricata-Main$</field>
    <description>SOC/Falco: creación de packet socket por Suricata (FP suprimido)</description>
    <group>falco,false_positive,</group>
  </rule>

  <!-- Fase 6 · Persistencia vía cron (T1053) -->
  <rule id="110050" level="10">
    <if_sid>110000</if_sid>
    <field name="output_fields.proc.name">^crontab$</field>
    <description>SOC/Falco: modificación de tareas cron (persistencia)</description>
    <mitre>
      <id>T1053.003</id>
    </mitre>
    <group>falco,persistence,</group>
  </rule>

  <rule id="110051" level="10">
    <if_sid>110002</if_sid>
    <field name="process_exec.process.binary">/crontab$</field>
    <description>SOC/Tetragon: ejecucion de crontab (persistencia)</description>
    <mitre>
      <id>T1053.003</id>
    </mitre>
    <group>tetragon,persistence,</group>
  </rule>

  <!-- Fase 1 · Correlación de fuerza bruta SSH (T1110).
       Reutiliza la detección sshd de Wazuh; eleva el nivel
       cuando hay múltiples fallos del mismo origen. -->
  <rule id="110060" level="10" frequency="6" timeframe="120">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>SOC: fuerza bruta SSH (múltiples fallos del mismo origen)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,ids,</group>
  </rule>

</group>
