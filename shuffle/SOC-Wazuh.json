{"workflow_as_code":false,"actions":[{"app_name":"Shuffle Tools","app_version":"1.2.0","description":"Runs python with the data input. Any prints will be returned. Avoid __main__ as it is not supported in this environment.","app_id":"037959ba-1ff3-4df7-bf8b-5924e481cf85","errors":[],"id":"55882027-69c2-40f7-ae76-7f2a30188147","is_valid":true,"isStartNode":true,"sharing":true,"label":"Shuffle_Tools_1","public":true,"generated":false,"large_image":"data:image/svg+xml;utf-8,%3Csvg%20width=%2224%22%20height=%2224%22%20viewBox=%220%200%2048%2048%22%20version=%221.1%22%20xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cpath%20d=%22M17.3335%2028.1667L22.3335%2023.1667L17.3335%2018.1667%20M24%2029.8333H30.6667%22%20fill=%22none%22%20stroke=%22white%22%20stroke-width=%221.5%22%20stroke-linecap=%22round%22%20stroke-linejoin=%22round%22/%3E%3C/svg%3E","environment":"","name":"execute_python","parameters":[{"description":"The code to run. Can be a file ID from within Shuffle.","id":"","name":"code","example":"print(\"hello world\")","value":"import json, re\n\nalert = exec if isinstance(exec, dict) else json.loads(exec)\n\ndata   = alert.get(\"data\", {}) or {}\nsource = alert.get(\"source\", \"unknown\")\nlevel  = int(alert.get(\"level\", 0) or 0)\nfulllog = alert.get(\"full_log\", \"\") or \"\"\n\nobservables = []\ndef add(dtype, value):\n    if value and str(value).strip() and {\"dataType\": dtype, \"data\": str(value)} not in observables:\n        observables.append({\"dataType\": dtype, \"data\": str(value)})\n\n# --- IOCs por sensor ---\nif source == \"suricata\":\n    add(\"ip\", data.get(\"src_ip\"))\n    add(\"ip\", data.get(\"dest_ip\"))\n    add(\"domain\", (data.get(\"dns\") or {}).get(\"rrname\"))\n    add(\"fqdn\", (data.get(\"http\") or {}).get(\"hostname\"))\n    add(\"url\", (data.get(\"http\") or {}).get(\"url\"))\n    add(\"hash\", (data.get(\"fileinfo\") or {}).get(\"sha256\"))\nelif source == \"falco\":\n    of = data.get(\"output_fields\", data)\n    add(\"filename\", of.get(\"fd.name\"))\n    add(\"other\", of.get(\"proc.cmdline\"))\nelif source == \"tetragon\":\n    pe = data.get(\"process_exec\", {}).get(\"process\", {})\n    add(\"filename\", pe.get(\"binary\"))\n\n# Rescate por regex sobre el log crudo (IPs y hashes que se hayan escapado)\nfor ip in set(re.findall(r\"\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b\", fulllog)):\n    add(\"ip\", ip)\nfor h in set(re.findall(r\"\\b[a-fA-F0-9]{64}\\b\", fulllog)):\n    add(\"hash\", h)\n\n# --- Severidad base por nivel Wazuh (1=Low ... 4=Critical) ---\nif   level >= 15: sev = 4\nelif level >= 12: sev = 3\nelif level >= 7:  sev = 2\nelse:             sev = 1\n\nreturn {\n    \"source\": source,\n    \"severity_base\": sev,\n    \"level\": level,\n    \"observables\": observables,\n    \"ioc_list\": [o[\"data\"] for o in observables]\n}","multiline":true,"multiselect":false,"options":null,"action_field":"","variant":"","required":true,"configuration":false,"tags":null,"schema":{"type":"string"},"skip_multicheck":false,"custom_value":false,"value_replace":null,"unique_toggled":false,"error":"","hidden":false}],"execution_variable":{"description":"","id":"","name":"","value":""},"position":{"x":467.001,"y":405.6},"authentication_id":"","category":"Other","reference_url":"","sub_action":false,"run_magic_output":false,"run_magic_input":false,"execution_delay":0,"category_label":null,"suggestion":false,"parent_controlled":false,"source_workflow":"","source_execution":""}],"branches":[{"destination_id":"55882027-69c2-40f7-ae76-7f2a30188147","id":"5a8e1c63-f392-45ef-9ec1-dd93429e9c8c","source_id":"04cedd12-f45e-4e83-80ff-669b50358067","label":"","has_errors":false,"conditions":null,"decorator":false,"parent_controlled":false,"source_parent":""}],"visual_branches":[],"triggers":[{"app_name":"Webhook","description":"Custom HTTP input trigger","long_description":"Execute a workflow with an unauthicated POST request","status":"stopped","app_version":"1.0.0","errors":[],"id":"04cedd12-f45e-4e83-80f